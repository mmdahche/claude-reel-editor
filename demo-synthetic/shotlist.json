{
  "version": 1,
  "title": "Synthetic install test (no real footage)",
  "about": "Matches scripts/make-demo.sh: the face is an ffmpeg test pattern and the voice is text-to-speech. Each line has a fixed slot, so these times never change. Build it with the test-only brand: clients/_demo-test-only/brand.json.",
  "duration": 32.0,
  "recording": { "src": "demo-synthetic/face.mp4", "offset": 0, "eyeX": 0.5, "eyeY": 0.4, "grade": false },
  "captures": {
    "screen": { "src": "demo-synthetic/captures/screen.mp4", "grade": false }
  },
  "beats": [
    { "id": "b01", "start": 0, "end": 3.0, "tag": "HOOK", "mode": "A2", "layout": "split",
      "line": "This is a test reel, made by a script.",
      "proof": { "capture": "screen", "at": 0, "label": "TEST FOOTAGE", "focusY": 0.5 },
      "scene": { "type": "hook-title", "persist": 0, "inputs": { "kicker": "INSTALL CHECK", "line1": "A test reel,", "line2": "made by a *script*." } } },
    { "id": "b02", "start": 3.0, "end": 6.0, "tag": "LOCKIN", "mode": "A2", "layout": "split",
      "line": "No real person is in it, only test patterns.",
      "proof": { "capture": "screen", "at": 3.0, "label": "TEST PATTERN", "focusY": 0.5 } },
    { "id": "b03", "start": 6.0, "end": 8.5, "tag": "LOCKIN", "mode": "B",
      "line": "That keeps the install check private." },
    { "id": "b04", "start": 8.5, "end": 12.0, "tag": "BODY", "mode": "A",
      "line": "Build it, check it, then look at it.",
      "scene": { "type": "steps", "inputs": { "kicker": "THREE STEPS", "title": "The *check*", "steps": ["Build", "Check", "Look"], "times": [0.3, 1.1, 1.9], "doneAt": 2.9 } } },
    { "id": "b05", "start": 12.0, "end": 15.0, "tag": "BODY", "mode": "C",
      "line": "The check must show zero errors.",
      "scene": { "type": "stat", "inputs": { "kicker": "HYPERFRAMES CHECK", "value": 0, "from": 9, "label": "ERRORS", "tone": "win", "countAt": 0.2, "countDur": 0.9 } },
      "pip": { "start": 12.5, "end": 15.0 } },
    { "id": "b06", "start": 15.0, "end": 18.5, "tag": "BODY", "mode": "A",
      "line": "Compare the two exports side by side.",
      "scene": { "type": "table", "inputs": { "heading": "Two *exports*", "columns": [{ "name": "Music" }, { "name": "No music" }], "rows": [ { "label": "Voice", "t": 0.5, "cells": [{ "text": "YES", "tone": "win" }, { "text": "YES", "tone": "win" }] }, { "label": "Bed", "t": 1.2, "cells": [{ "text": "YES", "tone": "win" }, { "text": "NO", "tone": "muted" }] }, { "label": "SFX", "t": 1.9, "cells": [{ "text": "YES", "tone": "win" }, { "text": "YES", "tone": "win" }] } ], "dimAt": 2.6, "shakeAt": 2.75 } },
      "overlays": [{ "type": "stamp", "at": 17.6, "inputs": { "kicker": "ALWAYS", "line": "Ship both files", "cash": false, "centerY": 800 } }] },
    { "id": "b07", "start": 18.5, "end": 21.0, "tag": "BODY", "mode": "A",
      "line": "A client quote sits on a light plate.",
      "scene": { "type": "quote", "inputs": { "kind": "post", "name": "Test Client", "handle": "@testclient", "text": "A sample quote for the install test.", "highlight": "install test", "meta": "SAMPLE TEXT" } } },
    { "id": "b08", "start": 21.0, "end": 24.0, "tag": "BODY", "mode": "A2", "layout": "card",
      "line": "Screen footage can sit in a card.",
      "proof": { "capture": "screen", "at": 6.0, "label": "CARD LAYOUT", "focusY": 0.5 } },
    { "id": "b09", "start": 24.0, "end": 26.5, "tag": "BODY", "mode": "A",
      "line": "Logs type in line by line.",
      "scene": { "type": "receipt", "inputs": { "title": "build log", "lines": ["$ node scripts/build.mjs", "brand: _demo-test-only", "check: 0 errors"], "times": [0.2, 0.8, 1.4], "highlight": 2 } } },
    { "id": "b10", "start": 26.5, "end": 28.5, "tag": "BODY", "mode": "B",
      "line": "And then we are done.",
      "overlays": [{ "type": "word-slam", "at": 27.6, "inputs": { "word": "DONE.", "tone": "white" } }] },
    { "id": "b11", "start": 28.5, "end": 32.0, "tag": "CTA", "mode": "C",
      "line": "Comment TEST and I will send the guide.",
      "scene": { "type": "cta", "inputs": { "lead": "Comment", "keyword": "TEST", "sub": "and I will send the guide", "typeAt": 0.6, "dmAt": 2.0, "dmText": "Here is the guide", "guideKicker": "THE GUIDE", "guideTitle": "Install *check*", "guideSub": "SAMPLE" } },
      "pip": { "start": 28.5, "end": 30.4 } }
  ]
}
